# Traczi Billing Server - Example Environment Variables
# Replace placeholders with your actual values before running locally.

# Traccar (backend) connection
TRACCAR_BASE_URL=https://api.traczi.com
TRACCAR_ADMIN_EMAIL=admin@example.com
TRACCAR_ADMIN_PASSWORD=change_me

# Stripe (use your own keys; do NOT commit real secrets)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URL (used in emails/links)
FRONTEND_BASE_URL=https://app.traczi.com

# Logging
LOG_LEVEL=info
